# Import required libraries
import numpy as np
from scipy.spatial.distance import cdist
from sklearn.cluster import KMeans
from sklearn.metrics import mean_squared_error

# ----------------------------
# Step 1: Generate sample data
# ----------------------------
np.random.seed(0)
X = np.random.rand(100, 2)          # 100 samples, 2 features each
y = np.sin(X[:, 0]) + np.cos(X[:, 1])  # target values

# ----------------------------
# Step 2: Define RBF function
# ----------------------------
def rbf(x, c, s):
    """
    x : input sample (vector)
    c : center of RBF neuron
    s : spread (sigma)
    returns the RBF activation
    """
    return np.exp(-np.linalg.norm(x - c) ** 2 / (2 * s ** 2))

# ----------------------------
# Step 3: Choose centers using K-Means
# ----------------------------
kmeans = KMeans(n_clusters=10, random_state=0).fit(X)
centers = kmeans.cluster_centers_   # 10 RBF neuron centers

# ----------------------------
# Step 4: Calculate spread (sigma)
# ----------------------------
d_max = np.max(cdist(centers, centers, 'euclidean'))  # max distance between centers
sigma = d_max / np.sqrt(2 * len(centers))            # spread formula

# ----------------------------
# Step 5: Compute RBF layer output
# ----------------------------
R = np.zeros((X.shape[0], len(centers)))  # 100 x 10 matrix
for i in range(X.shape[0]):
    for j in range(len(centers)):
        R[i, j] = rbf(X[i], centers[j], sigma)

# ----------------------------
# Step 6: Compute output weights
# ----------------------------
W = np.dot(np.linalg.pinv(R), y)  # pseudo-inverse to solve weights

# ----------------------------
# Step 7: Define prediction function
# ----------------------------
def rbf_network(X, centers, sigma, W):
    R = np.zeros((X.shape[0], len(centers)))
    for i in range(X.shape[0]):
        for j in range(len(centers)):
            R[i, j] = rbf(X[i], centers[j], sigma)
    return np.dot(R, W)

# ----------------------------
# Step 8: Make predictions
# ----------------------------
y_pred = rbf_network(X, centers, sigma, W)

# ----------------------------
# Step 9: Evaluate model
# ----------------------------
mse = mean_squared_error(y, y_pred)
print(f"Mean Squared Error : {mse:.4f}")
